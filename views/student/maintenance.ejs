<section class="page-section">
  <div class="page-header">
    <h1><i class="fas fa-tools"></i> Maintenance Requests</h1>
    <p class="page-subtitle">Report issues and track repairs</p>
  </div>

  <!-- Submit New Request -->
  <% if (currentRoom) { %>
    <div class="section-card glass-card">
      <div class="section-header">
        <h2><i class="fas fa-plus-circle"></i> Report New Issue</h2>
        <span class="text-muted">Room: <%= currentRoom.block.name %> - <%= currentRoom.roomNumber %></span>
      </div>
      <form action="/student/maintenance" method="POST" id="maintenance-form">
        <div class="form-row">
          <div class="form-group">
            <label for="category">
              <i class="fas fa-tag"></i> Category *
            </label>
            <select id="category" name="category" required>
              <option value="">Select category</option>
              <option value="plumbing">🔧 Plumbing</option>
              <option value="electrical">⚡ Electrical</option>
              <option value="cleaning">🧹 Cleaning</option>
              <option value="furniture">🪑 Furniture</option>
              <option value="other">📋 Other</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label for="description">
            <i class="fas fa-pen"></i> Description *
          </label>
          <textarea id="description" name="description" rows="3" placeholder="Describe the issue in detail..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary" id="submit-maintenance">
          <i class="fas fa-paper-plane"></i> Submit Request
        </button>
      </form>
    </div>
  <% } else { %>
    <div class="section-card glass-card">
      <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle"></i>
        <span>You need a room before you can submit maintenance requests.</span>
      </div>
    </div>
  <% } %>

  <!-- My Requests -->
  <% if (myRequests.length > 0) { %>
    <div class="section-card glass-card">
      <div class="section-header">
        <h2><i class="fas fa-list"></i> My Requests (<%= myRequests.length %>)</h2>
      </div>
      <div class="requests-list">
        <% myRequests.forEach(req => { %>
          <div class="request-card maintenance-<%= req.status %>">
            <div class="request-info">
              <div class="request-details">
                <span class="badge badge-category-<%= req.category %>">
                  <%= req.category === 'plumbing' ? '🔧' : req.category === 'electrical' ? '⚡' : req.category === 'cleaning' ? '🧹' : req.category === 'furniture' ? '🪑' : '📋' %>
                  <%= req.category %>
                </span>
                <span class="badge badge-<%= req.status %>"><%= req.status.replace('_', ' ') %></span>
                <span class="text-muted"><%= new Date(req.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
              </div>
              <p class="request-description"><%= req.description %></p>
              <% if (req.adminRemarks) { %>
                <p class="admin-remarks"><i class="fas fa-comment"></i> Admin: <%= req.adminRemarks %></p>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  <% } %>
</section>

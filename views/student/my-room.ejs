<section class="page-section">
  <div class="page-header">
    <h1><i class="fas fa-bed"></i> My Room</h1>
    <p class="page-subtitle">Your room details and roommates</p>
  </div>

  <% if (!currentRoom) { %>
    <div class="section-card glass-card">
      <div class="empty-state">
        <i class="fas fa-bed"></i>
        <h3>No Room Allocated</h3>
        <p>You don't have a room yet. Submit a room request to get started.</p>
        <a href="/student/request-room" class="btn btn-primary">
          <i class="fas fa-plus-circle"></i> Request Room
        </a>
      </div>
    </div>
  <% } else { %>
    <div class="room-detail-grid">
      <!-- Room Info -->
      <div class="section-card glass-card">
        <div class="section-header">
          <h2><i class="fas fa-info-circle"></i> Room Information</h2>
        </div>
        <div class="room-info-display">
          <div class="room-info-item">
            <span class="label"><i class="fas fa-building"></i> Block</span>
            <span class="value"><%= currentRoom.block.name %></span>
          </div>
          <div class="room-info-item">
            <span class="label"><i class="fas fa-door-open"></i> Room Number</span>
            <span class="value"><%= currentRoom.roomNumber %></span>
          </div>
          <div class="room-info-item">
            <span class="label"><i class="fas fa-layer-group"></i> Floor</span>
            <span class="value"><%= currentRoom.floor %></span>
          </div>
          <div class="room-info-item">
            <span class="label"><i class="fas fa-bed"></i> Type</span>
            <span class="value badge badge-room-type"><%= currentRoom.type %></span>
          </div>
          <div class="room-info-item">
            <span class="label"><i class="fas fa-users"></i> Occupancy</span>
            <span class="value"><%= currentRoom.occupants.length %>/<%= currentRoom.capacity %></span>
          </div>
          <div class="room-info-item">
            <span class="label"><i class="fas fa-circle"></i> Status</span>
            <span class="value badge badge-status-<%= currentRoom.status %>"><%= currentRoom.status.replace('_', ' ') %></span>
          </div>
        </div>
      </div>

      <!-- Roommates -->
      <div class="section-card glass-card">
        <div class="section-header">
          <h2><i class="fas fa-users"></i> Roommates</h2>
        </div>
        <% if (currentRoom.occupants.length <= 1) { %>
          <div class="empty-state small">
            <i class="fas fa-user"></i>
            <p>You don't have any roommates yet.</p>
          </div>
        <% } else { %>
          <div class="roommates-list">
            <% currentRoom.occupants.forEach(occ => { %>
              <% if (occ._id.toString() !== currentUser._id.toString()) { %>
                <div class="roommate-card">
                  <div class="roommate-avatar">
                    <i class="fas fa-user-circle"></i>
                  </div>
                  <div class="roommate-info">
                    <strong><%= occ.name %></strong>
                    <span class="text-muted"><%= occ.email %></span>
                    <% if (occ.studentId) { %>
                      <span class="badge badge-info">ID: <%= occ.studentId %></span>
                    <% } %>
                    <% if (occ.phone) { %>
                      <span class="text-muted"><i class="fas fa-phone"></i> <%= occ.phone %></span>
                    <% } %>
                  </div>
                </div>
              <% } %>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="quick-actions">
      <div class="actions-grid">
        <a href="/student/room-change" class="action-card">
          <i class="fas fa-exchange-alt"></i>
          <span>Request Room Change</span>
        </a>
        <a href="/student/maintenance" class="action-card">
          <i class="fas fa-tools"></i>
          <span>Report Issue</span>
        </a>
      </div>
    </div>
  <% } %>
</section>

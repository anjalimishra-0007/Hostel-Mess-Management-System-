<section class="page-section">
  <div class="page-header">
    <h1><i class="fas fa-plus-circle"></i> Request Room</h1>
    <p class="page-subtitle">Submit a room allotment request</p>
  </div>

  <% if (pendingRequest) { %>
    <div class="section-card glass-card">
      <div class="alert alert-warning">
        <i class="fas fa-clock"></i>
        <span>You already have a pending room request. Please wait for the admin to review it.</span>
      </div>
    </div>
  <% } else { %>
    <div class="section-card glass-card">
      <div class="section-header">
        <h2><i class="fas fa-paper-plane"></i> New Request</h2>
      </div>
      <form action="/student/request-room" method="POST" id="request-room-form">
        <div class="form-row">
          <div class="form-group">
            <label for="preferredBlock">
              <i class="fas fa-building"></i> Preferred Block (optional)
            </label>
            <select id="preferredBlock" name="preferredBlock">
              <option value="">No preference</option>
              <% blocks.forEach(block => { %>
                <option value="<%= block._id %>"><%= block.name %> (<%= block.type %>)</option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="preferredRoomType">
              <i class="fas fa-bed"></i> Preferred Room Type (optional)
            </label>
            <select id="preferredRoomType" name="preferredRoomType">
              <option value="">No preference</option>
              <option value="single">Single (1 bed)</option>
              <option value="double">Double (2 beds)</option>
              <option value="triple">Triple (3 beds)</option>
            </select>
          </div>
        </div>
        <button type="submit" class="btn btn-primary" id="submit-room-request">
          <i class="fas fa-paper-plane"></i> Submit Request
        </button>
      </form>
    </div>
  <% } %>

  <!-- My Requests History -->
  <% if (myRequests.length > 0) { %>
    <div class="section-card glass-card">
      <div class="section-header">
        <h2><i class="fas fa-history"></i> My Requests</h2>
      </div>
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Preferred Block</th>
              <th>Preferred Type</th>
              <th>Status</th>
              <th>Allocated Room</th>
              <th>Remarks</th>
            </tr>
          </thead>
          <tbody>
            <% myRequests.forEach(req => { %>
              <tr>
                <td><%= new Date(req.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                <td><%= req.preferredBlock ? req.preferredBlock.name : 'Any' %></td>
                <td><%= req.preferredRoomType || 'Any' %></td>
                <td><span class="badge badge-<%= req.status %>"><%= req.status %></span></td>
                <td>
                  <% if (req.allocatedRoom) { %>
                    <%= req.allocatedRoom.block ? req.allocatedRoom.block.name + ' - ' : '' %><%= req.allocatedRoom.roomNumber %>
                  <% } else { %>
                    -
                  <% } %>
                </td>
                <td><%= req.adminRemarks || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</section>

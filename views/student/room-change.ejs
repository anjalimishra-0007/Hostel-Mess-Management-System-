<section class="page-section">
  <div class="page-header">
    <h1><i class="fas fa-exchange-alt"></i> Room Change Request</h1>
    <p class="page-subtitle">Request a room transfer</p>
  </div>

  <div class="section-card glass-card">
    <div class="section-header">
      <h2><i class="fas fa-door-open"></i> Current Room: <%= currentRoom.block.name %> - <%= currentRoom.roomNumber %></h2>
    </div>

    <% if (pendingRequest) { %>
      <div class="alert alert-warning">
        <i class="fas fa-clock"></i>
        <span>You already have a pending room change request. Please wait for the admin to review it.</span>
      </div>
    <% } else { %>
      <form action="/student/room-change" method="POST" id="room-change-form">
        <div class="form-row">
          <div class="form-group">
            <label for="preferredBlock">
              <i class="fas fa-building"></i> Preferred Block (optional)
            </label>
            <select id="preferredBlock" name="preferredBlock">
              <option value="">No preference</option>
              <% blocks.forEach(block => { %>
                <option value="<%= block._id %>"><%= block.name %> (<%= block.type %>)</option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="preferredRoomType">
              <i class="fas fa-bed"></i> Preferred Room Type (optional)
            </label>
            <select id="preferredRoomType" name="preferredRoomType">
              <option value="">No preference</option>
              <option value="single">Single</option>
              <option value="double">Double</option>
              <option value="triple">Triple</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label for="reason">
            <i class="fas fa-pen"></i> Reason for Change *
          </label>
          <textarea id="reason" name="reason" rows="3" placeholder="Explain why you want to change your room..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary" id="submit-room-change">
          <i class="fas fa-paper-plane"></i> Submit Request
        </button>
      </form>
    <% } %>
  </div>

  <!-- History -->
  <% if (myRequests.length > 0) { %>
    <div class="section-card glass-card">
      <div class="section-header">
        <h2><i class="fas fa-history"></i> Request History</h2>
      </div>
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>From Room</th>
              <th>Reason</th>
              <th>Status</th>
              <th>New Room</th>
              <th>Remarks</th>
            </tr>
          </thead>
          <tbody>
            <% myRequests.forEach(req => { %>
              <tr>
                <td><%= new Date(req.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %></td>
                <td><%= req.currentRoom && req.currentRoom.block ? req.currentRoom.block.name + ' - ' + req.currentRoom.roomNumber : 'N/A' %></td>
                <td class="truncate"><%= req.reason %></td>
                <td><span class="badge badge-<%= req.status %>"><%= req.status %></span></td>
                <td><%= req.newRoom && req.newRoom.block ? req.newRoom.block.name + ' - ' + req.newRoom.roomNumber : '-' %></td>
                <td><%= req.adminRemarks || '-' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  <% } %>
</section>

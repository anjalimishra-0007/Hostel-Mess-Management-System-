<section class="page-section">
  <div class="page-header">
    <h1><i class="fas fa-cubes"></i> Manage Blocks</h1>
    <p class="page-subtitle">Create and manage hostel blocks</p>
  </div>

  <!-- Create Block Form -->
  <div class="section-card glass-card">
    <div class="section-header">
      <h2><i class="fas fa-plus-circle"></i> Create New Block</h2>
    </div>
    <form action="/admin/blocks" method="POST" class="inline-form" id="create-block-form">
      <div class="form-row">
        <div class="form-group">
          <label for="block-name">Block Name</label>
          <input type="text" id="block-name" name="name" placeholder="e.g., Block A" required>
        </div>
        <div class="form-group">
          <label for="block-type">Type</label>
          <select id="block-type" name="type" required>
            <option value="">Select type</option>
            <option value="boys">Boys</option>
            <option value="girls">Girls</option>
          </select>
        </div>
        <div class="form-group">
          <label for="block-description">Description</label>
          <input type="text" id="block-description" name="description" placeholder="Optional description">
        </div>
        <div class="form-group form-action">
          <button type="submit" class="btn btn-primary" id="create-block-btn">
            <i class="fas fa-plus"></i> Create Block
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- Blocks List -->
  <div class="section-card glass-card">
    <div class="section-header">
      <h2><i class="fas fa-list"></i> All Blocks (<%= blocks.length %>)</h2>
    </div>
    <% if (blocks.length === 0) { %>
      <div class="empty-state">
        <i class="fas fa-cubes"></i>
        <p>No blocks created yet. Use the form above to create your first block.</p>
      </div>
    <% } else { %>
      <div class="cards-grid">
        <% blocks.forEach(block => { %>
          <div class="info-card">
            <div class="info-card-header">
              <h3><i class="fas fa-building"></i> <%= block.name %></h3>
              <span class="badge badge-<%= block.type %>"><%= block.type %></span>
            </div>
            <div class="info-card-body">
              <p><strong>Total Rooms:</strong> <%= block.totalRooms %></p>
              <% if (block.description) { %>
                <p><strong>Description:</strong> <%= block.description %></p>
              <% } %>
            </div>
            <div class="info-card-footer">
              <form action="/admin/blocks/<%= block._id %>/delete" method="POST" class="inline-form" onsubmit="return confirm('Are you sure you want to delete this block?')">
                <button type="submit" class="btn btn-danger btn-sm">
                  <i class="fas fa-trash"></i> Delete
                </button>
              </form>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

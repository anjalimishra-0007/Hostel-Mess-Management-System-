# MongoDB Connection String (e.g. MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hostel_management?retryWrites=true&w=majority

# Session Secret (any random secure string)
SESSION_SECRET=your_super_secret_session_key_here

# Port (defaults to 3000 locally, Render sets this automatically)
PORT=3000
